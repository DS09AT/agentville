{
  "name": "agentville",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local dashboard for Claude Code and Codex sessions",
  "bin": {
    "agentville": "bin/agentville.mjs"
  },
  "files": [
    "bin/",
    "collector/",
    "!collector/test/",
    "web/",
    "mod/.claude-plugin/plugin.json",
    "mod/hooks/",
    "mod/types/",
    "scripts/new-world.mjs",
    "scripts/check-world.mjs",
    "scripts/lib/",
    "config.example.json"
  ],
  "scripts": {
    "test": "node --test \"collector/test/*.test.mjs\"",
    "test:ui": "node scripts/e2e-ui.mjs",
    "golden": "node scripts/world-golden.mjs",
    "new-world": "node scripts/new-world.mjs",
    "world-shots": "node scripts/world-shots.mjs",
    "check-world": "node scripts/check-world.mjs",
    "kit-sheet": "node scripts/kit-sheet.mjs",
    "demo": "node scripts/demo-video.mjs",
    "demo:many": "node scripts/demo-many.mjs",
    "start": "node bin/agentville.mjs run"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/DS09AT/agentville.git"
  },
  "dependencies": {
    "@colyseus/core": "^0.18.18",
    "@colyseus/schema": "^5.0.36",
    "@colyseus/sdk": "^0.18.5",
    "@colyseus/ws-transport": "^0.18.4",
    "@jitl/quickjs-wasmfile-release-sync": "^0.32.0",
    "quickjs-emscripten-core": "^0.32.0",
    "selfsigned": "^5.5.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "ws": "^8.22.0"
  }
}
